    "@google/genai": "^2.19.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
